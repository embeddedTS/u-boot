/ {
        aliases {
                //mmc0 = &usdhc2;
                mmc0 = &usdhc3;
                //mmc1 = &usdhc3;
                usb0 = &usbotg;
                video0 = &ipu1;
        };

	binman {
		filename = "ts4900-uboot.bin";
		pad-byte = <0xff>;
		size = <0x00100000>;
		sort-by-offset;
		symbols-base = <0>;

		spl: blob-ext@1 {
			filename = "SPL";
			/* XXX: TODO: Verify this offset is needed */
			offset = <0x400>;
		};

		uboot: blob-ext@2 {
			filename = "u-boot-dtb.img";
			// Must match CONFIG_SYS_SPI_U_BOOT_OFFS!
			offset = <0x00040000>; // XXX: TODO: Better align this
		};
	};
		

	reg_sd_vmmc: regulator-sd-vmmc {
		compatible = "regulator-fixed";
		regulator-name = "SD_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&gpio2 28 GPIO_ACTIVE_HIGH>;
	};

        soc {
                bootph-pre-ram;
                bootph-all;

                bus@2000000 {
                        bootph-pre-ram;
                        spba-bus@2000000 {
                                bootph-pre-ram;
                        };
                };

                bus@2100000 {
                        bootph-pre-ram;
                };
        };
};

&usdhc1 {
	status = "disabled";
};

&usdhc2 {
	bootph-pre-ram;
	vmmc-supply = <&reg_sd_vmmc>;
	status = "disabled";
};

&usdhc3 {
        no-1-8-v;
        bootph-pre-ram;
};

&pinctrl_usdhc3 {
        bootph-pre-ram;
};

&gpio1 {
        bootph-pre-ram;
};

&iomuxc {
        bootph-pre-ram;
};

&ipu1 {
        bootph-all;
};

